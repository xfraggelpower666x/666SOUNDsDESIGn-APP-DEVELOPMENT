{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "666DEV project profile",
  "type": "object",
  "required": ["schema_version", "id", "name", "source_mode", "expected_ref", "entry_points", "build_contracts", "test_paths", "writable_paths", "acceptance"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "name": {"type": "string", "minLength": 1},
    "source_mode": {"enum": ["monorepo", "linked"]},
    "source_path": {"type": "string"},
    "expected_repository": {"type": "string"},
    "expected_ref": {"type": "string", "minLength": 1},
    "entry_points": {"type": "array", "items": {"type": "string"}},
    "language_files": {"type": "array", "items": {"type": "string"}},
    "build_contracts": {"type": "array", "items": {"type": "string"}},
    "test_paths": {"type": "array", "items": {"type": "string"}},
    "writable_paths": {"type": "array", "items": {"type": "string"}},
    "build_commands": {"type": "array", "items": {"type": "string"}},
    "test_commands": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"source_mode": {"const": "monorepo"}}}, "then": {"required": ["source_path"]}},
    {"if": {"properties": {"source_mode": {"const": "linked"}}}, "then": {"required": ["expected_repository"]}}
  ],
  "additionalProperties": true
}
